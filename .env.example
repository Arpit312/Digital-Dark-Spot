# ==============================================================================
#                     DARKSPOT ATLAS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# Simply paste your API keys right after the '=' sign without quotes or spaces.
# Example: GEMINI_API_KEY=AIzaSy...
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API KEYS (At least Gemini is required; Groq serves as high-speed fallback)
# ------------------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/app/apikey (Starts with: AIza...)
GEMINI_API_KEY=

# Groq Console: https://console.groq.com/keys (Starts with: gsk_...)
GROQ_API_KEY=


# ------------------------------------------------------------------------------
# 2. SEARCH API KEY (For fetching live official pages & guidelines)
# ------------------------------------------------------------------------------
# Tavily Search API: https://tavily.com (Starts with: tvly-...)
TAVILY_API_KEY=


# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (Project Settings -> API & Database)
# ------------------------------------------------------------------------------
# Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# Anon / Public Key (Project Settings -> API -> anon public key, starts with: eyJ...)
SUPABASE_ANON_KEY=

# Service Role Key (Optional: Project Settings -> API -> service_role key)
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret (Optional: Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=

# Direct Postgres Connection String (Optional: Project Settings -> Database -> URI)
DATABASE_URL=


# ------------------------------------------------------------------------------
# 4. SYSTEM & SERVER SETTINGS (Pre-configured defaults - No changes needed)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
USE_LOCAL_NLI=false
HF_TOKEN=
